---
/** Admin: property list with edit / delete actions. */
import Base from '../../../layouts/Base.astro';
import Notices from '../../../layouts/Notices.astro';
import StatusBadge from '../../../layouts/StatusBadge.astro';
import { getDB } from '../../../lib/db';
import { inr0 } from '../../../lib/money';
import { typeLabel } from '../../../lib/validation';

interface PropertyRow {
  id: string;
  title: string;
  type: string;
  area_sqft: number;
  price_per_sqft: number;
  total_price: number;
  status: string;
  image_count: number;
}

const db = getDB(Astro.locals);
let properties: PropertyRow[] = [];
if (db) {
  properties = (
    await db
      .prepare(
        `SELECT p.id, p.title, p.type, p.area_sqft, p.price_per_sqft, p.total_price, p.status,
                (SELECT COUNT(*) FROM property_images WHERE property_id = p.id) AS image_count
         FROM properties p ORDER BY p.created_at DESC`,
      )
      .all<PropertyRow>()
  ).results;
}
---
<Base title="Manage Properties">
  <Notices />

  <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold text-slate-900">Properties</h1>
      <p class="mt-1 text-sm text-slate-600">{properties.length} propert{properties.length === 1 ? 'y' : 'ies'} listed.</p>
    </div>
    <a
      href="/admin/properties/new"
      class="rounded-md bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-800"
    >
      ＋ New Property
    </a>
  </div>

  {!db ? (
    <div class="rounded-xl border bg-white p-8 text-center shadow-sm">
      <p class="font-medium text-slate-700">Database unavailable</p>
      <p class="mt-1 text-sm text-slate-500">We could not load the properties right now. Please try again later.</p>
    </div>
  ) : properties.length === 0 ? (
    <div class="rounded-xl border bg-white p-12 text-center shadow-sm">
      <p class="text-lg font-medium text-slate-700">No properties yet.</p>
      <p class="mt-2 text-sm text-slate-500">Add your first property listing to get started.</p>
      <a href="/admin/properties/new" class="mt-4 inline-block rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-800">
        ＋ New Property
      </a>
    </div>
  ) : (
    <div class="overflow-x-auto rounded-xl border bg-white shadow-sm">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-slate-200 bg-slate-50 text-left text-xs uppercase tracking-wide text-slate-500">
            <th class="px-4 py-3">Title</th>
            <th class="px-4 py-3">Type</th>
            <th class="px-4 py-3 text-right">Area (sq ft)</th>
            <th class="px-4 py-3 text-right">Rate/sq ft</th>
            <th class="px-4 py-3 text-right">Total</th>
            <th class="px-4 py-3">Status</th>
            <th class="px-4 py-3 text-center">Images</th>
            <th class="px-4 py-3 text-right">Actions</th>
          </tr>
        </thead>
        <tbody>
          {properties.map((p, i) => (
            <tr class={i % 2 === 1 ? 'bg-slate-50' : ''}>
              <td class="px-4 py-3 font-medium text-slate-900">{p.title}</td>
              <td class="px-4 py-3 text-slate-600">{typeLabel(p.type)}</td>
              <td class="px-4 py-3 text-right text-slate-600">{Number(p.area_sqft).toLocaleString('en-IN')}</td>
              <td class="px-4 py-3 text-right text-slate-600">{inr0(p.price_per_sqft)}</td>
              <td class="px-4 py-3 text-right font-medium text-slate-900">{inr0(p.total_price)}</td>
              <td class="px-4 py-3"><StatusBadge status={p.status} /></td>
              <td class="px-4 py-3 text-center text-slate-600">{p.image_count}</td>
              <td class="px-4 py-3">
                <div class="flex justify-end gap-2">
                  <a
                    href={`/admin/properties/${p.id}/edit`}
                    class="rounded-md border border-slate-300 px-3 py-1.5 text-xs font-medium text-slate-700 hover:bg-slate-50"
                  >
                    Edit
                  </a>
                  <form
                    method="post"
                    action={`/api/admin/properties/${p.id}/delete`}
                    onsubmit="return confirm('Delete this property and all its images? This cannot be undone.')"
                    class="inline"
                  >
                    <button
                      type="submit"
                      class="rounded-md border border-red-200 px-3 py-1.5 text-xs font-medium text-red-700 hover:bg-red-50"
                    >
                      Delete
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}
</Base>
