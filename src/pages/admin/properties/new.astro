---
/** Admin: create a new property (multipart form with image upload). */
import Base from '../../../layouts/Base.astro';
import Notices from '../../../layouts/Notices.astro';

const inputCls =
  'mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-amber-500 focus:outline-none focus:ring-1 focus:ring-amber-500';
---
<Base title="New Property">
  <div class="mx-auto max-w-2xl">
    <a href="/admin/properties" class="text-sm text-slate-600 hover:text-slate-900">&larr; Back to properties</a>
    <div class="mt-4 rounded-xl border bg-white p-8 shadow-sm">
      <h1 class="text-2xl font-bold text-slate-900">New Property</h1>
      <div class="mt-4"><Notices /></div>

      <form method="post" action="/api/admin/properties" enctype="multipart/form-data" class="mt-2 space-y-5">
        <div>
          <label for="title" class="block text-sm font-medium text-slate-700">Title *</label>
          <input id="title" name="title" type="text" required maxlength="200" placeholder="e.g. Commercial Gala near Station Road" class={inputCls} />
        </div>

        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label for="type" class="block text-sm font-medium text-slate-700">Type *</label>
            <select id="type" name="type" required class={inputCls}>
              <option value="gala">Gala (Shop / Commercial Unit)</option>
              <option value="plot">Plot</option>
              <option value="flat">Flat</option>
            </select>
          </div>
          <div>
            <label for="status" class="block text-sm font-medium text-slate-700">Status *</label>
            <select id="status" name="status" required class={inputCls}>
              <option value="available">Available</option>
              <option value="on-hold">On Hold</option>
              <option value="sold">Sold</option>
            </select>
          </div>
        </div>

        <div>
          <label for="address" class="block text-sm font-medium text-slate-700">Address / location *</label>
          <input id="address" name="address" type="text" required maxlength="300" placeholder="e.g. Shop 12, Main Market, Mumbai" class={inputCls} />
        </div>

        <div class="grid gap-5 sm:grid-cols-3">
          <div>
            <label for="area_sqft" class="block text-sm font-medium text-slate-700">Area (sq ft) *</label>
            <input id="area_sqft" name="area_sqft" type="number" min="0.01" step="0.01" required placeholder="e.g. 500" class={inputCls} />
          </div>
          <div>
            <label for="price_per_sqft" class="block text-sm font-medium text-slate-700">Price per sq ft (₹) *</label>
            <input id="price_per_sqft" name="price_per_sqft" type="number" min="0" step="0.01" required placeholder="e.g. 8000" class={inputCls} />
          </div>
          <div>
            <label for="total_price" class="block text-sm font-medium text-slate-700">Total price (₹)</label>
            <input id="total_price" name="total_price" type="number" min="0.01" step="0.01" placeholder="Optional" class={inputCls} />
          </div>
        </div>
        <p class="-mt-3 text-xs text-slate-500">Leave total price blank for auto = area &times; rate per sq ft.</p>

        <div>
          <label for="description" class="block text-sm font-medium text-slate-700">Description</label>
          <textarea id="description" name="description" rows="4" maxlength="5000" placeholder="Facing, floor, nearby landmarks, terms…" class={inputCls}></textarea>
        </div>

        <div>
          <label for="images" class="block text-sm font-medium text-slate-700">Photos</label>
          <input id="images" name="images" type="file" accept="image/*" multiple class={`${inputCls} file:mr-3 file:rounded-md file:border-0 file:bg-slate-900 file:px-3 file:py-1.5 file:text-sm file:font-medium file:text-white`} />
          <p class="mt-1 text-xs text-slate-500">You can select multiple images. JPEG, PNG, WebP or GIF, up to 5 MB each.</p>
        </div>

        <button type="submit" class="w-full rounded-md bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white hover:bg-slate-800">
          Create property
        </button>
      </form>
    </div>
  </div>
</Base>
