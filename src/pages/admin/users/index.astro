---
/** Admin: user list + add-user form. */
import Base from '../../../layouts/Base.astro';
import Notices from '../../../layouts/Notices.astro';
import { getDB } from '../../../lib/db';

interface UserRow {
  id: string;
  name: string;
  email: string;
  phone: string | null;
  role: string;
  created_at: string;
}

const me = Astro.locals.user;
const db = getDB(Astro.locals);
let users: UserRow[] = [];
if (db) {
  users = (await db.prepare('SELECT id, name, email, phone, role, created_at FROM users ORDER BY created_at DESC').all<UserRow>()).results;
}

const fmtDate = (iso: string) =>
  new Date(iso).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });

const inputCls =
  'mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-amber-500 focus:outline-none focus:ring-1 focus:ring-amber-500';
---
<Base title="Manage Users">
  <Notices />

  <div class="mb-6">
    <h1 class="text-2xl font-bold text-slate-900">Users</h1>
    <p class="mt-1 text-sm text-slate-600">{users.length} registered user{users.length === 1 ? '' : 's'}.</p>
  </div>

  {!db ? (
    <div class="rounded-xl border bg-white p-8 text-center shadow-sm">
      <p class="font-medium text-slate-700">Database unavailable</p>
      <p class="mt-1 text-sm text-slate-500">We could not load the users right now. Please try again later.</p>
    </div>
  ) : (
    <div class="grid gap-8 lg:grid-cols-3">
      <div class="lg:col-span-2">
        {users.length === 0 ? (
          <div class="rounded-xl border bg-white p-8 text-center text-sm text-slate-500 shadow-sm">
            No users yet.
          </div>
        ) : (
          <div class="overflow-x-auto rounded-xl border bg-white shadow-sm">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-slate-200 bg-slate-50 text-left text-xs uppercase tracking-wide text-slate-500">
                  <th class="px-4 py-3">Name</th>
                  <th class="px-4 py-3">Email</th>
                  <th class="px-4 py-3">Phone</th>
                  <th class="px-4 py-3">Role</th>
                  <th class="px-4 py-3">Joined</th>
                  <th class="px-4 py-3 text-right">Actions</th>
                </tr>
              </thead>
              <tbody>
                {users.map((u, i) => (
                  <tr class={i % 2 === 1 ? 'bg-slate-50' : ''}>
                    <td class="px-4 py-3 font-medium text-slate-900">{u.name}</td>
                    <td class="px-4 py-3 text-slate-600">{u.email}</td>
                    <td class="px-4 py-3 text-slate-600">{u.phone || '—'}</td>
                    <td class="px-4 py-3">
                      <span class={`inline-block rounded-full border px-2.5 py-0.5 text-xs font-medium ${
                        u.role === 'admin'
                          ? 'border-amber-300 bg-amber-100 text-amber-800'
                          : 'border-slate-200 bg-slate-100 text-slate-700'
                      }`}>
                        {u.role === 'admin' ? 'Admin' : 'User'}
                      </span>
                    </td>
                    <td class="px-4 py-3 text-slate-600">{fmtDate(u.created_at)}</td>
                    <td class="px-4 py-3 text-right">
                      {me && u.id === me.id ? (
                        <span class="text-xs text-slate-400">You</span>
                      ) : (
                        <form
                          method="post"
                          action="/api/admin/users/delete"
                          onsubmit={`return confirm('Delete user ${u.email}? Their applications stay, but they will no longer be able to log in.')`}
                          class="inline"
                        >
                          <input type="hidden" name="user_id" value={u.id} />
                          <button type="submit" class="rounded-md border border-red-200 px-3 py-1.5 text-xs font-medium text-red-700 hover:bg-red-50">
                            Delete
                          </button>
                        </form>
                      )}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </div>

      <div>
        <div class="rounded-xl border bg-white p-6 shadow-sm">
          <h2 class="text-lg font-semibold text-slate-900">Add user</h2>
          <form method="post" action="/api/admin/users/create" class="mt-4 space-y-4">
            <div>
              <label for="name" class="block text-sm font-medium text-slate-700">Full name *</label>
              <input id="name" name="name" type="text" required maxlength="120" class={inputCls} />
            </div>
            <div>
              <label for="email" class="block text-sm font-medium text-slate-700">Email *</label>
              <input id="email" name="email" type="email" required maxlength="254" class={inputCls} />
            </div>
            <div>
              <label for="phone" class="block text-sm font-medium text-slate-700">Phone</label>
              <input id="phone" name="phone" type="tel" maxlength="30" class={inputCls} />
            </div>
            <div>
              <label for="password" class="block text-sm font-medium text-slate-700">Password *</label>
              <input id="password" name="password" type="password" required minlength="8" autocomplete="new-password" class={inputCls} />
              <p class="mt-1 text-xs text-slate-500">At least 8 characters.</p>
            </div>
            <div>
              <label for="role" class="block text-sm font-medium text-slate-700">Role *</label>
              <select id="role" name="role" required class={inputCls}>
                <option value="user">User</option>
                <option value="admin">Admin</option>
              </select>
            </div>
            <button type="submit" class="w-full rounded-md bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white hover:bg-slate-800">
              Create user
            </button>
          </form>
        </div>
      </div>
    </div>
  )}
</Base>
