---
/** Admin home: stat cards + latest pending applications / loans. */
import Base from '../../layouts/Base.astro';
import Notices from '../../layouts/Notices.astro';
import StatusBadge from '../../layouts/StatusBadge.astro';
import { getDB } from '../../lib/db';
import { inr0 } from '../../lib/money';

interface AppRow {
  id: string;
  created_at: string;
  user_name: string;
  property_title: string;
}
interface LoanRow {
  id: string;
  created_at: string;
  borrower: string;
  amount: number;
  tenure_months: number;
}

const db = getDB(Astro.locals);

const count = async (sql: string): Promise<number> => {
  if (!db) return 0;
  const row = await db.prepare(sql).first<{ c: number }>();
  return row?.c ?? 0;
};
const sum = async (sql: string): Promise<number> => {
  if (!db) return 0;
  const row = await db.prepare(sql).first<{ s: number | null }>();
  return row?.s ?? 0;
};

const totalProperties = await count('SELECT COUNT(*) AS c FROM properties');
const availableProperties = await count("SELECT COUNT(*) AS c FROM properties WHERE status = 'available'");
const totalUsers = await count('SELECT COUNT(*) AS c FROM users');
const pendingApplications = await count("SELECT COUNT(*) AS c FROM applications WHERE status = 'pending'");
const pendingLoans = await count("SELECT COUNT(*) AS c FROM loans WHERE status = 'pending'");
const approvedLoans = await count("SELECT COUNT(*) AS c FROM loans WHERE status = 'approved'");
const loanBook = await sum("SELECT SUM(amount) AS s FROM loans WHERE status = 'approved'");

let latestApps: AppRow[] = [];
let latestLoans: LoanRow[] = [];
if (db) {
  latestApps = (
    await db
      .prepare(
        `SELECT a.id, a.created_at, u.name AS user_name, p.title AS property_title
         FROM applications a JOIN users u ON u.id = a.user_id JOIN properties p ON p.id = a.property_id
         WHERE a.status = 'pending' ORDER BY a.created_at DESC LIMIT 5`,
      )
      .all<AppRow>()
  ).results;
  latestLoans = (
    await db
      .prepare(
        `SELECT l.id, l.created_at, COALESCE(u.name, l.manual_name, '—') AS borrower, l.amount, l.tenure_months
         FROM loans l LEFT JOIN users u ON u.id = l.user_id
         WHERE l.status = 'pending' ORDER BY l.created_at DESC LIMIT 5`,
      )
      .all<LoanRow>()
  ).results;
}

const fmtDate = (iso: string) =>
  new Date(iso).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });

const cards = [
  { label: 'Total properties', value: String(totalProperties), href: '/admin/properties' },
  { label: 'Available properties', value: String(availableProperties), href: '/admin/properties' },
  { label: 'Total users', value: String(totalUsers), href: '/admin/users' },
  { label: 'Pending applications', value: String(pendingApplications), href: '/admin/applications' },
  { label: 'Pending loans', value: String(pendingLoans), href: '/admin/loans' },
  { label: 'Approved loans', value: String(approvedLoans), href: '/admin/loans' },
  { label: 'Total loan book', value: inr0(loanBook), href: '/admin/loans' },
];
---
<Base title="Admin Panel">
  <Notices />

  <div class="mb-6">
    <h1 class="text-2xl font-bold text-slate-900">Admin Panel</h1>
    <p class="mt-1 text-sm text-slate-600">Overview of properties, applications and loans.</p>
  </div>

  {!db ? (
    <div class="rounded-xl border bg-white p-8 text-center shadow-sm">
      <p class="font-medium text-slate-700">Database unavailable</p>
      <p class="mt-1 text-sm text-slate-500">Stats could not be loaded right now. Please try again later.</p>
    </div>
  ) : (
    <div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {cards.map((c) => (
          <a href={c.href} class="rounded-xl border bg-white p-5 shadow-sm transition-shadow hover:shadow-md">
            <p class="text-xs uppercase tracking-wide text-slate-500">{c.label}</p>
            <p class="mt-1 text-2xl font-bold text-slate-900">{c.value}</p>
          </a>
        ))}
      </div>

      <div class="mt-10 grid gap-8 lg:grid-cols-2">
        <section>
          <div class="mb-4 flex items-center justify-between">
            <h2 class="text-lg font-semibold text-slate-900">Latest pending applications</h2>
            <a href="/admin/applications" class="text-sm font-medium text-amber-600 hover:text-amber-700">View all &rarr;</a>
          </div>
          {latestApps.length === 0 ? (
            <div class="rounded-xl border bg-white p-6 text-center text-sm text-slate-500 shadow-sm">
              No pending applications.
            </div>
          ) : (
            <div class="overflow-hidden rounded-xl border bg-white shadow-sm">
              <table class="w-full text-sm">
                <tbody>
                  {latestApps.map((a, i) => (
                    <tr class={i % 2 === 1 ? 'bg-slate-50' : ''}>
                      <td class="px-4 py-3">
                        <p class="font-medium text-slate-900">{a.user_name}</p>
                        <p class="text-xs text-slate-500">{a.property_title} &middot; {fmtDate(a.created_at)}</p>
                      </td>
                      <td class="px-4 py-3 text-right">
                        <a href="/admin/applications" class="font-medium text-amber-600 hover:text-amber-700">Review</a>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </section>

        <section>
          <div class="mb-4 flex items-center justify-between">
            <h2 class="text-lg font-semibold text-slate-900">Latest pending loans</h2>
            <a href="/admin/loans" class="text-sm font-medium text-amber-600 hover:text-amber-700">View all &rarr;</a>
          </div>
          {latestLoans.length === 0 ? (
            <div class="rounded-xl border bg-white p-6 text-center text-sm text-slate-500 shadow-sm">
              No pending loans.
            </div>
          ) : (
            <div class="overflow-hidden rounded-xl border bg-white shadow-sm">
              <table class="w-full text-sm">
                <tbody>
                  {latestLoans.map((l, i) => (
                    <tr class={i % 2 === 1 ? 'bg-slate-50' : ''}>
                      <td class="px-4 py-3">
                        <p class="font-medium text-slate-900">{l.borrower}</p>
                        <p class="text-xs text-slate-500">
                          {inr0(l.amount)} &middot; {l.tenure_months} months &middot; {fmtDate(l.created_at)}
                        </p>
                      </td>
                      <td class="px-4 py-3 text-right">
                        <a href={`/admin/loans/${l.id}`} class="font-medium text-amber-600 hover:text-amber-700">Review</a>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </section>
      </div>

      <div class="mt-10 rounded-xl border bg-white p-6 shadow-sm">
        <h2 class="text-lg font-semibold text-slate-900">Quick links</h2>
        <div class="mt-3 flex flex-wrap gap-3">
          <a href="/admin/properties/new" class="rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-800">＋ New Property</a>
          <a href="/admin/loans/new" class="rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-800">＋ New Manual Loan</a>
          <a href="/admin/users" class="rounded-md border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">Manage Users</a>
          <a href="/admin/settings" class="rounded-md border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">Settings</a>
        </div>
      </div>
    </div>
  )}
</Base>
