---
/** Admin: review pending applications + decided history. */
import Base from '../../../layouts/Base.astro';
import Notices from '../../../layouts/Notices.astro';
import StatusBadge from '../../../layouts/StatusBadge.astro';
import { getDB } from '../../../lib/db';
import { typeLabel } from '../../../lib/validation';

interface AppRow {
  id: string;
  status: string;
  note: string | null;
  created_at: string;
  decided_at: string | null;
  user_name: string;
  user_email: string;
  user_phone: string | null;
  property_id: string;
  property_title: string;
  property_type: string;
}

const db = getDB(Astro.locals);
let pending: AppRow[] = [];
let decided: AppRow[] = [];
if (db) {
  const base = `SELECT a.id, a.status, a.note, a.created_at, a.decided_at,
                       u.name AS user_name, u.email AS user_email, u.phone AS user_phone,
                       p.id AS property_id, p.title AS property_title, p.type AS property_type
                FROM applications a
                JOIN users u ON u.id = a.user_id
                JOIN properties p ON p.id = a.property_id`;
  pending = (await db.prepare(`${base} WHERE a.status = 'pending' ORDER BY a.created_at DESC`).all<AppRow>()).results;
  decided = (await db.prepare(`${base} WHERE a.status != 'pending' ORDER BY a.decided_at DESC LIMIT 50`).all<AppRow>()).results;
}

const fmtDate = (iso: string | null) =>
  iso ? new Date(iso).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) : '—';

const noteCls =
  'mt-2 w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-amber-500 focus:outline-none focus:ring-1 focus:ring-amber-500';
---
<Base title="Applications">
  <Notices />

  <div class="mb-6">
    <h1 class="text-2xl font-bold text-slate-900">Applications</h1>
    <p class="mt-1 text-sm text-slate-600">Review property applications from users.</p>
  </div>

  {!db ? (
    <div class="rounded-xl border bg-white p-8 text-center shadow-sm">
      <p class="font-medium text-slate-700">Database unavailable</p>
      <p class="mt-1 text-sm text-slate-500">We could not load the applications right now. Please try again later.</p>
    </div>
  ) : (
    <div class="space-y-10">
      <section>
        <h2 class="mb-4 text-lg font-semibold text-slate-900">
          Pending <span class="text-sm font-normal text-slate-500">({pending.length})</span>
        </h2>
        {pending.length === 0 ? (
          <div class="rounded-xl border bg-white p-8 text-center text-sm text-slate-500 shadow-sm">
            No pending applications. New user applications will appear here.
          </div>
        ) : (
          <div class="grid gap-5 lg:grid-cols-2">
            {pending.map((a) => (
              <div class="rounded-xl border bg-white p-5 shadow-sm">
                <div class="flex items-start justify-between gap-3">
                  <div>
                    <p class="font-semibold text-slate-900">{a.user_name}</p>
                    <p class="text-xs text-slate-500">{a.user_email}{a.user_phone ? ` · ${a.user_phone}` : ''}</p>
                  </div>
                  <StatusBadge status={a.status} />
                </div>
                <div class="mt-3 rounded-md bg-slate-50 px-3 py-2 text-sm">
                  <a href={`/properties/${a.property_id}`} class="font-medium text-slate-900 hover:underline">{a.property_title}</a>
                  <p class="text-xs text-slate-500">{typeLabel(a.property_type)}</p>
                </div>
                <p class="mt-2 text-xs text-slate-500">Applied on {fmtDate(a.created_at)}</p>

                <div class="mt-4 grid gap-3 sm:grid-cols-2">
                  <form method="post" action="/api/admin/applications/decide">
                    <input type="hidden" name="application_id" value={a.id} />
                    <input type="hidden" name="decision" value="approve" />
                    <label class="block text-xs font-medium text-slate-600">Note (optional)</label>
                    <input name="note" type="text" maxlength="1000" placeholder="Note for the user" class={noteCls} />
                    <button type="submit" class="mt-2 w-full rounded-md bg-green-600 px-3 py-2 text-sm font-semibold text-white hover:bg-green-700">
                      Approve
                    </button>
                  </form>
                  <form method="post" action="/api/admin/applications/decide">
                    <input type="hidden" name="application_id" value={a.id} />
                    <input type="hidden" name="decision" value="reject" />
                    <label class="block text-xs font-medium text-slate-600">Note (optional)</label>
                    <input name="note" type="text" maxlength="1000" placeholder="Reason shown to user" class={noteCls} />
                    <button type="submit" class="mt-2 w-full rounded-md bg-red-600 px-3 py-2 text-sm font-semibold text-white hover:bg-red-700">
                      Reject
                    </button>
                  </form>
                </div>
              </div>
            ))}
          </div>
        )}
      </section>

      <section>
        <h2 class="mb-4 text-lg font-semibold text-slate-900">Decided</h2>
        {decided.length === 0 ? (
          <div class="rounded-xl border bg-white p-8 text-center text-sm text-slate-500 shadow-sm">
            No decisions recorded yet.
          </div>
        ) : (
          <div class="overflow-x-auto rounded-xl border bg-white shadow-sm">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-slate-200 bg-slate-50 text-left text-xs uppercase tracking-wide text-slate-500">
                  <th class="px-4 py-3">User</th>
                  <th class="px-4 py-3">Property</th>
                  <th class="px-4 py-3">Status</th>
                  <th class="px-4 py-3">Note</th>
                  <th class="px-4 py-3">Decided</th>
                </tr>
              </thead>
              <tbody>
                {decided.map((a, i) => (
                  <tr class={i % 2 === 1 ? 'bg-slate-50' : ''}>
                    <td class="px-4 py-3">
                      <p class="font-medium text-slate-900">{a.user_name}</p>
                      <p class="text-xs text-slate-500">{a.user_email}</p>
                    </td>
                    <td class="px-4 py-3 text-slate-600">{a.property_title}</td>
                    <td class="px-4 py-3"><StatusBadge status={a.status} /></td>
                    <td class="px-4 py-3 text-slate-600">{a.note || '—'}</td>
                    <td class="px-4 py-3 text-slate-600">{fmtDate(a.decided_at)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </section>
    </div>
  )}
</Base>
