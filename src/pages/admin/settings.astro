---
/** Admin: default interest settings (prefill the loan approval form). */
import Base from '../../layouts/Base.astro';
import Notices from '../../layouts/Notices.astro';
import { getDB } from '../../lib/db';

const db = getDB(Astro.locals);
let defaultPct = '10';
let defaultType = 'reducing';

if (db) {
  const pctRow = await db.prepare("SELECT value FROM settings WHERE key = 'default_interest_pct' LIMIT 1").first<{ value: string }>();
  const typeRow = await db.prepare("SELECT value FROM settings WHERE key = 'default_interest_type' LIMIT 1").first<{ value: string }>();
  if (pctRow?.value) defaultPct = pctRow.value;
  if (typeRow?.value === 'flat' || typeRow?.value === 'reducing') defaultType = typeRow.value;
}
---
<Base title="Settings">
  <div class="mx-auto max-w-lg">
    <h1 class="text-2xl font-bold text-slate-900">Settings</h1>
    <p class="mt-1 text-sm text-slate-600">Default loan interest terms for the admin team.</p>
    <div class="mt-4"><Notices /></div>

    {!db ? (
      <div class="rounded-xl border bg-white p-8 text-center shadow-sm">
        <p class="font-medium text-slate-700">Database unavailable</p>
        <p class="mt-1 text-sm text-slate-500">Settings could not be loaded right now. Please try again later.</p>
      </div>
    ) : (
      <div class="mt-4 rounded-xl border bg-white p-8 shadow-sm">
        <form method="post" action="/api/admin/settings" class="space-y-5">
          <div>
            <label for="default_interest_pct" class="block text-sm font-medium text-slate-700">Default interest % p.a.</label>
            <input
              id="default_interest_pct" name="default_interest_pct" type="number" min="0" max="100" step="0.01" required
              value={defaultPct}
              class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-amber-500 focus:outline-none focus:ring-1 focus:ring-amber-500"
            />
          </div>
          <div>
            <span class="block text-sm font-medium text-slate-700">Default interest type</span>
            <div class="mt-2 flex gap-6">
              <label class="flex items-center gap-2 text-sm text-slate-700">
                <input type="radio" name="default_interest_type" value="reducing" checked={defaultType === 'reducing'} class="accent-amber-500" />
                Reducing balance
              </label>
              <label class="flex items-center gap-2 text-sm text-slate-700">
                <input type="radio" name="default_interest_type" value="flat" checked={defaultType === 'flat'} class="accent-amber-500" />
                Flat rate
              </label>
            </div>
          </div>
          <p class="rounded-md bg-slate-50 px-4 py-3 text-xs text-slate-500">
            Prefills the loan approval form — you can still set any % and type per loan.
          </p>
          <button type="submit" class="w-full rounded-md bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white hover:bg-slate-800">
            Save settings
          </button>
        </form>
      </div>
    )}
  </div>
</Base>
