---
/** 404 — branded not-found page. */
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <div class="mx-auto max-w-md rounded-xl border bg-white p-12 text-center shadow-sm">
    <p class="text-5xl font-bold text-amber-500">404</p>
    <h1 class="mt-4 text-xl font-bold text-slate-900">Page not found</h1>
    <p class="mt-2 text-sm text-slate-600">The page you are looking for does not exist or was moved.</p>
    <a
      href="/"
      class="mt-6 inline-block rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-800"
    >
      Back to properties
    </a>
  </div>
</Base>
