---
/** User dashboard: my applications + my loans. */
import Base from '../../layouts/Base.astro';
import Notices from '../../layouts/Notices.astro';
import StatusBadge from '../../layouts/StatusBadge.astro';
import { getDB } from '../../lib/db';
import { inr, inr0 } from '../../lib/money';
import { interestLabel } from '../../lib/emi';
import { typeLabel } from '../../lib/validation';

interface AppRow {
  id: string;
  status: string;
  note: string | null;
  created_at: string;
  property_title: string;
  property_type: string;
  has_loan: number;
}
interface LoanRow {
  id: string;
  amount: number;
  tenure_months: number;
  interest_pct: number | null;
  interest_type: string;
  status: string;
  emi: number | null;
  created_at: string;
  property_title: string | null;
}

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/login?next=' + encodeURIComponent('/dashboard'));
}

const db = getDB(Astro.locals);
let applications: AppRow[] = [];
let loans: LoanRow[] = [];

if (db) {
  applications = (
    await db
      .prepare(
        `SELECT a.id, a.status, a.note, a.created_at, p.title AS property_title, p.type AS property_type,
                (SELECT COUNT(*) FROM loans l WHERE l.application_id = a.id AND l.status IN ('pending','approved')) AS has_loan
         FROM applications a JOIN properties p ON p.id = a.property_id
         WHERE a.user_id = ? ORDER BY a.created_at DESC`,
      )
      .bind(user.id)
      .all<AppRow>()
  ).results;

  loans = (
    await db
      .prepare(
        `SELECT l.id, l.amount, l.tenure_months, l.interest_pct, l.interest_type, l.status, l.emi, l.created_at,
                p.title AS property_title
         FROM loans l LEFT JOIN properties p ON p.id = l.property_id
         WHERE l.user_id = ? ORDER BY l.created_at DESC`,
      )
      .bind(user.id)
      .all<LoanRow>()
  ).results;
}

const fmtDate = (iso: string) =>
  new Date(iso).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
---
<Base title="My Dashboard">
  <Notices />

  <div class="mb-8">
    <h1 class="text-2xl font-bold text-slate-900">My Dashboard</h1>
    <p class="mt-1 text-sm text-slate-600">Track your property applications and loans.</p>
  </div>

  {!db ? (
    <div class="rounded-xl border bg-white p-8 text-center shadow-sm">
      <p class="font-medium text-slate-700">Database unavailable</p>
      <p class="mt-1 text-sm text-slate-500">We could not load your dashboard right now. Please try again later.</p>
    </div>
  ) : (
    <div class="space-y-10">
      <section>
        <h2 class="mb-4 text-lg font-semibold text-slate-900">My Applications</h2>
        {applications.length === 0 ? (
          <div class="rounded-xl border bg-white p-8 text-center shadow-sm">
            <p class="text-sm text-slate-600">You have not applied for any property yet.</p>
            <a href="/" class="mt-3 inline-block rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-800">
              Browse properties
            </a>
          </div>
        ) : (
          <div class="overflow-x-auto rounded-xl border bg-white shadow-sm">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-slate-200 bg-slate-50 text-left text-xs uppercase tracking-wide text-slate-500">
                  <th class="px-4 py-3">Property</th>
                  <th class="px-4 py-3">Type</th>
                  <th class="px-4 py-3">Status</th>
                  <th class="px-4 py-3">Applied</th>
                  <th class="px-4 py-3">Admin note</th>
                  <th class="px-4 py-3">Action</th>
                </tr>
              </thead>
              <tbody>
                {applications.map((a, i) => (
                  <tr class={i % 2 === 1 ? 'bg-slate-50' : ''}>
                    <td class="px-4 py-3 font-medium text-slate-900">{a.property_title}</td>
                    <td class="px-4 py-3 text-slate-600">{typeLabel(a.property_type)}</td>
                    <td class="px-4 py-3"><StatusBadge status={a.status} /></td>
                    <td class="px-4 py-3 text-slate-600">{fmtDate(a.created_at)}</td>
                    <td class="px-4 py-3 text-slate-600">{a.note || '—'}</td>
                    <td class="px-4 py-3">
                      {a.status === 'approved' && a.has_loan === 0 ? (
                        <a
                          href={`/dashboard/loans/new?application_id=${a.id}`}
                          class="rounded-md bg-amber-500 px-3 py-1.5 text-xs font-semibold text-slate-900 hover:bg-amber-600"
                        >
                          Apply for Loan
                        </a>
                      ) : (
                        <span class="text-xs text-slate-400">—</span>
                      )}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </section>

      <section>
        <h2 class="mb-4 text-lg font-semibold text-slate-900">My Loans</h2>
        {loans.length === 0 ? (
          <div class="rounded-xl border bg-white p-8 text-center shadow-sm">
            <p class="text-sm text-slate-600">No loans yet. Once an application is approved you can apply for a loan.</p>
          </div>
        ) : (
          <div class="overflow-x-auto rounded-xl border bg-white shadow-sm">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-slate-200 bg-slate-50 text-left text-xs uppercase tracking-wide text-slate-500">
                  <th class="px-4 py-3">Loan</th>
                  <th class="px-4 py-3">Property</th>
                  <th class="px-4 py-3">Amount</th>
                  <th class="px-4 py-3">Tenure</th>
                  <th class="px-4 py-3">Interest</th>
                  <th class="px-4 py-3">Status</th>
                  <th class="px-4 py-3">EMI</th>
                  <th class="px-4 py-3"></th>
                </tr>
              </thead>
              <tbody>
                {loans.map((l, i) => (
                  <tr class={i % 2 === 1 ? 'bg-slate-50' : ''}>
                    <td class="px-4 py-3 font-mono text-xs text-slate-600">{l.id}</td>
                    <td class="px-4 py-3 text-slate-600">{l.property_title || '—'}</td>
                    <td class="px-4 py-3 font-medium text-slate-900">{inr0(l.amount)}</td>
                    <td class="px-4 py-3 text-slate-600">{l.tenure_months} months</td>
                    <td class="px-4 py-3 text-slate-600">{interestLabel(l.interest_pct, l.interest_type)}</td>
                    <td class="px-4 py-3"><StatusBadge status={l.status} /></td>
                    <td class="px-4 py-3 font-medium text-slate-900">{inr(l.emi)}</td>
                    <td class="px-4 py-3">
                      {l.status === 'approved' ? (
                        <a href={`/dashboard/loans/${l.id}`} class="font-medium text-amber-600 hover:text-amber-700">
                          View EMI schedule
                        </a>
                      ) : (
                        <span class="text-xs text-slate-400">—</span>
                      )}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </section>
    </div>
  )}
</Base>
