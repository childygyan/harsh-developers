---
/** Small colored status badge: pending/available/approved/rejected/on-hold/sold etc. */
interface Props {
  status: string;
}
const { status } = Astro.props;

const colors: Record<string, string> = {
  available: 'bg-green-100 text-green-800 border-green-200',
  approved: 'bg-green-100 text-green-800 border-green-200',
  pending: 'bg-amber-100 text-amber-800 border-amber-200',
  'on-hold': 'bg-amber-100 text-amber-800 border-amber-200',
  rejected: 'bg-red-100 text-red-800 border-red-200',
  sold: 'bg-slate-200 text-slate-700 border-slate-300',
};
const label = status.charAt(0).toUpperCase() + status.slice(1).replace(/-/g, ' ');
const cls = colors[status] ?? 'bg-slate-100 text-slate-700 border-slate-200';
---
<span class={`inline-block rounded-full border px-2.5 py-0.5 text-xs font-medium ${cls}`}>{label}</span>
